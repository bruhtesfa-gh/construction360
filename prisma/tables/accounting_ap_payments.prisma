/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model accounting_ap_payments {
  ap_payment_id                                   String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  builder_id                                      String      @db.Uuid
  ap_invoice_id                                   String      @db.Uuid
  payment_method                                  String?     @db.VarChar(50)
  payment_amount                                  Decimal     @db.Decimal(12, 2)
  payment_date                                    DateTime    @db.Timestamptz(6)
  check_number                                    String?     @db.VarChar(50)
  reference_number                                String?     @db.VarChar(100)
  notes                                           String?
  created_by                                      String?     @db.Uuid
  modified_by                                     String?     @db.Uuid
  created_at                                      DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at                                      DateTime?   @default(now()) @db.Timestamptz(6)
  ap_invoices                                     ap_invoices @relation(fields: [ap_invoice_id], references: [ap_invoice_id], onDelete: Cascade, onUpdate: NoAction)
  builders                                        builders    @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction)
  users_accounting_ap_payments_created_byTousers  users?      @relation("accounting_ap_payments_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_accounting_ap_payments_modified_byTousers users?      @relation("accounting_ap_payments_modified_byTousers", fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([builder_id], map: "idx_accounting_ap_payments_builder_id")
  @@index([ap_invoice_id], map: "idx_accounting_ap_payments_invoice_id")
}