/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ap_invoices {
  ap_invoice_id                        String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  builder_id                           String                   @db.Uuid
  region_id                            String                   @db.Uuid
  supplier_id                          String                   @db.Uuid
  invoice_number                       String                   @db.VarChar(40)
  job_number                           String?                  @db.VarChar(50)
  status                               String?                  @db.VarChar(15)
  pretax_amount                        Decimal?                 @db.Decimal(14, 2)
  tax_amount                           Decimal?                 @db.Decimal(12, 2)
  misc_deduction_amount                Decimal?                 @db.Decimal(12, 2)
  discount_amount                      Decimal?                 @db.Decimal(12, 2)
  discount_date                        DateTime?                @db.Timestamptz(6)
  received_date                        DateTime?                @db.Timestamptz(6)
  invoice_date                         DateTime                 @db.Timestamptz(6)
  payment_due_date                     DateTime?                @db.Timestamptz(6)
  accounting_date                      DateTime?                @db.Timestamptz(6)
  description                          String?                  @db.VarChar(500)
  errors                               String?                  @db.VarChar(2000)
  source                               String?                  @db.VarChar(20)
  created_by                           String?                  @db.Uuid
  modified_by                          String?                  @db.Uuid
  created_at                           DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at                           DateTime?                @default(now()) @db.Timestamptz(6)
  accounting_ap_payments               accounting_ap_payments[]
  ap_invoice_items                     ap_invoice_items[]
  builders                             builders                 @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction)
  users_ap_invoices_created_byTousers  users?                   @relation("ap_invoices_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_ap_invoices_modified_byTousers users?                   @relation("ap_invoices_modified_byTousers", fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  regions                              regions                  @relation(fields: [region_id], references: [region_id], onDelete: NoAction, onUpdate: NoAction)
  suppliers                            suppliers                @relation(fields: [supplier_id], references: [supplier_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([builder_id], map: "idx_ap_invoices_builder_id")
  @@index([invoice_number], map: "idx_ap_invoices_invoice_number")
  @@index([region_id], map: "idx_ap_invoices_region_id")
  @@index([supplier_id], map: "idx_ap_invoices_supplier_id")
}
