/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model auth_permissions {
  auth_permission_id     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  builder_id             String                   @db.Uuid
  name                   String                   @db.VarChar(255)
  codename               String                   @db.VarChar(100)
  resource_type          String?                  @db.VarChar(100)
  created_at             DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?                @default(now()) @db.Timestamptz(6)
  auth_group_permissions auth_group_permissions[]
  builders               builders                 @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction)
  user_permissions       user_permissions[]

  @@unique([builder_id, codename])
  @@index([builder_id], map: "idx_auth_permissions_builder_id")
  @@index([codename], map: "idx_auth_permissions_codename")
}
