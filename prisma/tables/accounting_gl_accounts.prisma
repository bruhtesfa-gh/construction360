/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model accounting_gl_accounts {
  gl_account_id                                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  builder_id                                      String    @db.Uuid
  account_code                                    String    @db.VarChar(20)
  account_name                                    String    @db.VarChar(100)
  account_type                                    String    @db.VarChar(50)
  parent_account_code                             String?   @db.VarChar(20)
  is_active                                       Boolean?  @default(true)
  created_by                                      String?   @db.Uuid
  modified_by                                     String?   @db.Uuid
  created_at                                      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                                      DateTime? @default(now()) @db.Timestamptz(6)
  builders                                        builders  @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction)
  users_accounting_gl_accounts_created_byTousers  users?    @relation("accounting_gl_accounts_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_accounting_gl_accounts_modified_byTousers users?    @relation("accounting_gl_accounts_modified_byTousers", fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([builder_id, account_code])
  @@index([builder_id], map: "idx_accounting_gl_accounts_builder_id")
  @@index([account_code], map: "idx_accounting_gl_accounts_code")
}