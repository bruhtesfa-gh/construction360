/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model accounting_systems {
  accounting_system_id                        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  builder_id                                  String    @db.Uuid
  system_name                                 String    @db.VarChar(100)
  system_type                                 String    @db.VarChar(50)
  api_endpoint                                String?   @db.VarChar(500)
  api_key_encrypted                           String?
  is_enabled                                  Boolean?  @default(true)
  last_sync_date                              DateTime? @db.Timestamptz(6)
  sync_frequency_hours                        Int?      @default(24)
  created_by                                  String?   @db.Uuid
  modified_by                                 String?   @db.Uuid
  created_at                                  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                                  DateTime? @default(now()) @db.Timestamptz(6)
  builders                                    builders  @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction)
  users_accounting_systems_created_byTousers  users?    @relation("accounting_systems_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_accounting_systems_modified_byTousers users?    @relation("accounting_systems_modified_byTousers", fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([builder_id], map: "idx_accounting_systems_builder_id")
}
