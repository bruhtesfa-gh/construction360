/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model accounting_databases {
  accounting_database_id                        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  builder_id                                    String    @db.Uuid
  database_name                                 String    @db.VarChar(100)
  database_type                                 String    @db.VarChar(50)
  connection_string                             String?
  is_active                                     Boolean?  @default(true)
  created_by                                    String?   @db.Uuid
  modified_by                                   String?   @db.Uuid
  created_at                                    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                                    DateTime? @default(now()) @db.Timestamptz(6)
  builders                                      builders  @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction)
  users_accounting_databases_created_byTousers  users?    @relation("accounting_databases_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_accounting_databases_modified_byTousers users?    @relation("accounting_databases_modified_byTousers", fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([builder_id], map: "idx_accounting_databases_builder_id")
}