/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model communities_custom_fields {
    community_custom_field_id String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    builder_id                String      @db.Uuid
    community_id              String      @db.Uuid
    field_name                String      @db.VarChar(100)
    field_value               String?
    field_type                String?     @db.VarChar(50)
    created_at                DateTime?   @default(now()) @db.Timestamptz(6)
    updated_at                DateTime?   @default(now()) @db.Timestamptz(6)
    builders                  builders    @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction)
    communities               communities @relation(fields: [community_id], references: [community_id], onDelete: Cascade, onUpdate: NoAction)

    @@unique([community_id, field_name])
    @@index([builder_id], map: "idx_communities_custom_fields_builder_id")
    @@index([community_id], map: "idx_communities_custom_fields_community_id")
}

