/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ap_invoice_items {
  ap_invoice_item_id                        String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  builder_id                                String      @db.Uuid
  ap_invoice_id                             String      @db.Uuid
  line_number                               Int
  po_number                                 String?     @db.VarChar(50)
  quantity                                  Decimal?    @db.Decimal(12, 4)
  unit_cost                                 Decimal?    @db.Decimal(12, 4)
  total_cost                                Decimal?    @db.Decimal(14, 2)
  description                               String?     @db.VarChar(500)
  gl_account_code                           String?     @db.VarChar(20)
  created_by                                String?     @db.Uuid
  modified_by                               String?     @db.Uuid
  created_at                                DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at                                DateTime?   @default(now()) @db.Timestamptz(6)
  ap_invoices                               ap_invoices @relation(fields: [ap_invoice_id], references: [ap_invoice_id], onDelete: Cascade, onUpdate: NoAction)
  builders                                  builders    @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction)
  users_ap_invoice_items_created_byTousers  users?      @relation("ap_invoice_items_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_ap_invoice_items_modified_byTousers users?      @relation("ap_invoice_items_modified_byTousers", fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([builder_id], map: "idx_ap_invoice_items_builder_id")
  @@index([ap_invoice_id], map: "idx_ap_invoice_items_invoice_id")
}
