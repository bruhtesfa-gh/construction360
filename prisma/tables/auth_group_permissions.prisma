/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model auth_group_permissions {
  auth_group_permission_id String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  builder_id               String           @db.Uuid
  auth_group_id            String           @db.Uuid
  auth_permission_id       String           @db.Uuid
  created_at               DateTime?        @default(now()) @db.Timestamptz(6)
  auth_groups              auth_groups      @relation(fields: [auth_group_id], references: [auth_group_id], onDelete: Cascade, onUpdate: NoAction)
  auth_permissions         auth_permissions @relation(fields: [auth_permission_id], references: [auth_permission_id], onDelete: Cascade, onUpdate: NoAction)
  builders                 builders         @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([auth_group_id, auth_permission_id])
  @@index([builder_id], map: "idx_auth_group_permissions_builder_id")
  @@index([auth_group_id], map: "idx_auth_group_permissions_group_id")
  @@index([auth_permission_id], map: "idx_auth_group_permissions_permission_id")
}
