  users_warranty_work_orders_created_byTousers  users?            @relation("warranty_work_orders_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_warranty_work_orders_modified_byTousers users?            @relation("warranty_work_orders_modified_byTousers", fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  warranty_problems                             warranty_problems @relation(fields: [warranty_problem_id], references: [warranty_problem_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([builder_id, work_order_number])
  @@index([builder_id], map: "idx_warranty_work_orders_builder_id")
  @@index([warranty_problem_id], map: "idx_warranty_work_orders_problem_id")
  @@index([status], map: "idx_warranty_work_orders_status")
  @@index([assigned_supplier_id], map: "idx_warranty_work_orders_supplier_id")
}
