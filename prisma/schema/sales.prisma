/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sales_price_sheet_details {
  sales_price_sheet_detail_id                        String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  builder_id                                         String                   @db.Uuid
  sales_price_sheet_master_id                        String                   @db.Uuid
  item_type                                          String                   @db.VarChar(50)
  item_id                                            String?                  @db.Uuid
  item_code                                          String?                  @db.VarChar(100)
  item_name                                          String                   @db.VarChar(200)
  item_description                                   String?
  base_price                                         Decimal?                 @db.Decimal(12, 2)
  sale_price                                         Decimal?                 @db.Decimal(12, 2)
  discount_amount                                    Decimal?                 @default(0) @db.Decimal(12, 2)
  discount_percent                                   Decimal?                 @default(0) @db.Decimal(5, 2)
  markup_percent                                     Decimal?                 @default(0) @db.Decimal(5, 2)
  cost                                               Decimal?                 @db.Decimal(12, 2)
  category                                           String?                  @db.VarChar(100)
  display_order                                      Int?
  is_taxable                                         Boolean?                 @default(true)
  is_active                                          Boolean?                 @default(true)
  created_by                                         String?                  @db.Uuid
  modified_by                                        String?                  @db.Uuid
  created_at                                         DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at                                         DateTime?                @default(now()) @db.Timestamptz(6)
  builders                                           builders                 @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction)
  users_sales_price_sheet_details_created_byTousers  users?                   @relation("sales_price_sheet_details_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_sales_price_sheet_details_modified_byTousers users?                   @relation("sales_price_sheet_details_modified_byTousers", fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  sales_price_sheet_master                           sales_price_sheet_master @relation(fields: [sales_price_sheet_master_id], references: [sales_price_sheet_master_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([builder_id], map: "idx_sales_price_sheet_details_builder_id")
  @@index([item_type], map: "idx_sales_price_sheet_details_item_type")
  @@index([sales_price_sheet_master_id], map: "idx_sales_price_sheet_details_master_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sales_price_sheet_master {
  sales_price_sheet_master_id                       String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  builder_id                                        String                      @db.Uuid
  region_id                                         String                      @db.Uuid
  community_id                                      String?                     @db.Uuid
  price_sheet_name                                  String                      @db.VarChar(200)
  price_sheet_description                           String?
  effective_date                                    DateTime                    @db.Timestamptz(6)
  expiration_date                                   DateTime?                   @db.Timestamptz(6)
  version_number                                    String?                     @db.VarChar(20)
  is_active                                         Boolean?                    @default(true)
  approved_by                                       String?                     @db.Uuid
  approved_date                                     DateTime?                   @db.Timestamptz(6)
  created_by                                        String?                     @db.Uuid
  modified_by                                       String?                     @db.Uuid
  created_at                                        DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at                                        DateTime?                   @default(now()) @db.Timestamptz(6)
  sales_price_sheet_details                         sales_price_sheet_details[]
  users_sales_price_sheet_master_approved_byTousers users?                      @relation("sales_price_sheet_master_approved_byTousers", fields: [approved_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  builders                                          builders                    @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction)
  communities                                       communities?                @relation(fields: [community_id], references: [community_id], onDelete: NoAction, onUpdate: NoAction)
  users_sales_price_sheet_master_created_byTousers  users?                      @relation("sales_price_sheet_master_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_sales_price_sheet_master_modified_byTousers users?                      @relation("sales_price_sheet_master_modified_byTousers", fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  regions                                           regions                     @relation(fields: [region_id], references: [region_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([builder_id], map: "idx_sales_price_sheet_master_builder_id")
  @@index([community_id], map: "idx_sales_price_sheet_master_community_id")
  @@index([region_id], map: "idx_sales_price_sheet_master_region_id")
}
