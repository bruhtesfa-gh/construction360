/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model lender_contacts {
  lender_contact_id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  builder_id                               String    @db.Uuid
  lender_id                                String    @db.Uuid
  name                                     String    @db.VarChar(200)
  address1                                 String?   @db.VarChar(50)
  address2                                 String?   @db.VarChar(50)
  city                                     String?   @db.VarChar(50)
  state                                    String?   @db.VarChar(50)
  zip                                      String?   @db.VarChar(50)
  home_phone                               String?   @db.VarChar(50)
  mobile_phone                             String?   @db.VarChar(50)
  work_phone                               String?   @db.VarChar(50)
  fax                                      String?   @db.VarChar(50)
  email                                    String?   @db.VarChar(200)
  inactive                                 Boolean?  @default(false)
  created_by                               String    @db.Uuid
  modified_by                              String    @db.Uuid
  created_at                               DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                               DateTime? @default(now()) @db.Timestamptz(6)
  builders                                 builders  @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction)
  users_lender_contacts_created_byTousers  users     @relation("lender_contacts_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_lender_contacts_modified_byTousers users     @relation("lender_contacts_modified_byTousers", fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([lender_id, name])
  @@index([builder_id], map: "idx_lender_contacts_builder_id")
  @@index([lender_id], map: "idx_lender_contacts_lender_id")
}

