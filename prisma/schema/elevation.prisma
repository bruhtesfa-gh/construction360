  inventory_homes                     inventory_homes[]
  quote_contracts                     quote_contracts[]

  @@unique([region_id, community_id, community_phase_id, floor_plan_code, series])
  @@unique([region_id, floor_plan_code, elevation_code])
  @@index([builder_id], map: "idx_elevations_builder_id")
  @@index([elevation_code], map: "idx_elevations_elevation_code")
  @@index([floor_plan_code], map: "idx_elevations_floor_plan_code")
