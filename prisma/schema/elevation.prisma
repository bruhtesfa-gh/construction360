/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model elevation_images {
  elevation_image_id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  builder_id                String      @db.Uuid
  region_id                 String      @db.Uuid
  floor_plan_code           String      @db.VarChar(50)
  elevation_code            String      @db.VarChar(50)
  community_id              String      @db.Uuid
  description               String      @db.VarChar(200)
  sort_order                Int?
  image_path                String?     @db.VarChar(200)
  image_file                String?     @db.VarChar(200)
  storage_system_identifier String      @db.VarChar(200)
  inactive                  Boolean?    @default(false)
  created_at                DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?   @default(now()) @db.Timestamptz(6)
  builders                  builders    @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction)
  communities               communities @relation(fields: [community_id], references: [community_id], onDelete: NoAction, onUpdate: NoAction)
  regions                   regions     @relation(fields: [region_id], references: [region_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([builder_id], map: "idx_elevation_images_builder_id")
  @@index([floor_plan_code, elevation_code], map: "idx_elevation_images_codes")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model elevation_room_sizes {
  elevation_room_size_id String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  builder_id             String      @db.Uuid
  region_id              String      @db.Uuid
  community_id           String      @db.Uuid
  floor_plan_code        String      @db.VarChar(50)
  elevation_code         String      @db.VarChar(50)
  room_location          String      @db.VarChar(200)
  category_code          String      @db.VarChar(50)
  sub_category_code      String      @db.VarChar(50)
  unit_of_measure        String      @db.VarChar(50)
  quantity               Decimal?    @db.Decimal(10, 4)
  inactive               Boolean?    @default(false)
  created_at             DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?   @default(now()) @db.Timestamptz(6)
  builders               builders    @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction)
  communities            communities @relation(fields: [community_id], references: [community_id], onDelete: NoAction, onUpdate: NoAction)
  regions                regions     @relation(fields: [region_id], references: [region_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([region_id, community_id, floor_plan_code, elevation_code, room_location, category_code, sub_category_code, unit_of_measure])
  @@index([builder_id], map: "idx_elevation_room_sizes_builder_id")
  @@index([floor_plan_code, elevation_code], map: "idx_elevation_room_sizes_codes")
}

