  users_elevations_deleted_byTousers  users?            @relation("elevations_deleted_byTousers", fields: [deleted_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_elevations_modified_byTousers users             @relation("elevations_modified_byTousers", fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
