/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model claim_template_items {
  claim_template_item_id                        String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  builder_id                                    String          @db.Uuid
  claim_template_id                             String          @db.Uuid
  item_name                                     String          @db.VarChar(200)
  item_description                              String?
  item_category                                 String?         @db.VarChar(100)
  default_quantity                              Decimal?        @db.Decimal(10, 4)
  default_unit_cost                             Decimal?        @db.Decimal(10, 4)
  default_labor_hours                           Decimal?        @db.Decimal(6, 2)
  item_order                                    Int?
  is_required                                   Boolean?        @default(false)
  created_by                                    String?         @db.Uuid
  modified_by                                   String?         @db.Uuid
  created_at                                    DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at                                    DateTime?       @default(now()) @db.Timestamptz(6)
  builders                                      builders        @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction)
  claim_templates                               claim_templates @relation(fields: [claim_template_id], references: [claim_template_id], onDelete: Cascade, onUpdate: NoAction)
  users_claim_template_items_created_byTousers  users?          @relation("claim_template_items_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_claim_template_items_modified_byTousers users?          @relation("claim_template_items_modified_byTousers", fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([builder_id], map: "idx_claim_template_items_builder_id")
  @@index([claim_template_id], map: "idx_claim_template_items_template_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model claim_templates {
  claim_template_id                        String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  builder_id                               String                 @db.Uuid
  template_name                            String                 @db.VarChar(200)
  template_description                     String?
  claim_type                               String?                @db.VarChar(100)
  template_category                        String?                @db.VarChar(100)
  default_priority                         String?                @default("medium") @db.VarChar(20)
  default_warranty_period_months           Int?
  template_content                         String?
  is_active                                Boolean?               @default(true)
  created_by                               String?                @db.Uuid
  modified_by                              String?                @db.Uuid
  created_at                               DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at                               DateTime?              @default(now()) @db.Timestamptz(6)
  claim_template_items                     claim_template_items[]
  builders                                 builders               @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction)
  users_claim_templates_created_byTousers  users?                 @relation("claim_templates_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_claim_templates_modified_byTousers users?                 @relation("claim_templates_modified_byTousers", fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([builder_id], map: "idx_claim_templates_builder_id")
  @@index([claim_type], map: "idx_claim_templates_type")
}
