model room_master {
  room_master_id                       String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  builder_id                           String               @db.Uuid
  region_id                            String               @db.Uuid
  room_location                        String               @db.VarChar(200)
  floor_level                          String?              @db.VarChar(50)
  inactive                             Boolean              @default(false)
  inactive_date                        DateTime?            @db.Timestamptz(6)
  inactive_by                          String?              @db.Uuid
  created_by                           String?              @db.Uuid
  modified_by                          String?              @db.Uuid
  created_at                           DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at                           DateTime?            @default(now()) @db.Timestamptz(6)
