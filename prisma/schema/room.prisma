  users_room_master_created_byTousers  users?               @relation("room_master_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_room_master_inactive_byTousers users?               @relation("room_master_inactive_byTousers", fields: [inactive_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_room_master_modified_byTousers users?               @relation("room_master_modified_byTousers", fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  regions                              regions              @relation(fields: [region_id], references: [region_id], onDelete: Cascade, onUpdate: NoAction)
  room_subcategories                   room_subcategories[]

  @@unique([builder_id, region_id, room_location])
  @@index([builder_id], map: "idx_room_master_builder_id")
  @@index([inactive], map: "idx_room_master_inactive")
  @@index([region_id], map: "idx_room_master_region_id")
  @@index([room_location], map: "idx_room_master_room_location")
}

