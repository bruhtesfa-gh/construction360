  brochure                   String?                      @db.VarChar(200)
  selling_price              Decimal?                     @db.Decimal(12, 2)
  cost                       Decimal?                     @db.Decimal(12, 2)
  margin                     Decimal?                     @db.Decimal(7, 2)
  markup                     Decimal?                     @db.Decimal(7, 2)
  sales_price_sheet          Int?
  style                      String?                      @db.VarChar(200)
  is_deleted                 Boolean?                     @default(false)
  last_price_change          DateTime?                    @db.Timestamp(6)
  front_length               Decimal?                     @db.Decimal(9, 2)
  back_length                Decimal?                     @db.Decimal(9, 2)
  left_side_length           Decimal?                     @db.Decimal(9, 2)
  right_side_length          Decimal?                     @db.Decimal(9, 2)
  internal_notes             String?
  schedule_template_id       String?                      @db.Uuid
  floor_plan_code            String                       @db.VarChar(50)
  elevation_code             String?                      @db.VarChar(50)
  elevation_id               String?                      @db.Uuid
  deleted_date               DateTime?                    @db.Timestamp(6)
  deleted_by                 String?                      @db.Uuid
  created_by                 String?                      @db.Uuid
  modified_by                String?                      @db.Uuid
  created_at                 DateTime?                    @default(now()) @db.Timestamp(6)
  updated_at                 DateTime?                    @default(now()) @db.Timestamp(6)
  floor_plan_master_id       String?                      @db.Uuid
  floor_plan_master          floor_plan_master?           @relation(fields: [floor_plan_master_id], references: [floor_plan_master_id], onDelete: NoAction, onUpdate: NoAction, map: "floor_plan_community_master_id_fkey")
  builders                   builders                     @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction, map: "floor_plans_builder_id_fkey")
  communities                communities                  @relation(fields: [community_id], references: [community_id], onDelete: Cascade, onUpdate: NoAction, map: "floor_plans_community_id_fkey")
  regions                    regions                      @relation(fields: [region_id], references: [region_id], onDelete: Cascade, onUpdate: NoAction, map: "floor_plans_region_id_fkey")
  floor_plan_pricing_history floor_plan_pricing_history[]
  homes                      homes[]
  inventory_homes            inventory_homes[]
  quote_contracts            quote_contracts[]

  @@index([builder_id], map: "idx_floor_plan_community_builder_id")
  @@index([floor_plan_code], map: "idx_floor_plan_community_code")
  @@index([community_id], map: "idx_floor_plan_community_community_id")
}

