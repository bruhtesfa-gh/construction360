  region_id                  String                       @db.Uuid
  community_id               String                       @db.Uuid
  builder_id                 String                       @db.Uuid
  community_phase_id         String?                      @db.Uuid
  version_number             Int?
  series                     String?                      @db.VarChar(50)
  floor_plan_assembly_id     String?                      @db.Uuid
  description                String?                      @db.VarChar(200)
  comments                   String?
  floor_plan_orientation     String?                      @db.VarChar(50)
  num_of_beds                Decimal?                     @db.Decimal(9, 2)
