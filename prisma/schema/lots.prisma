model lot_custom_fields {
  lot_inventory_custom_field_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  builder_id                    String    @db.Uuid
  lot_id                        String    @db.Uuid
  field_name                    String    @db.VarChar(100)
  field_value                   String?
  field_type                    String?   @db.VarChar(50)
  created_at                    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime? @default(now()) @db.Timestamptz(6)
  lots                          lots      @relation(fields: [lot_id], references: [lot_id], onDelete: Cascade, onUpdate: NoAction)
  builders                      builders  @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction, map: "lot_inventory_custom_fields_builder_id_fkey")

  @@unique([lot_id, field_name], map: "lot_inventory_custom_fields_lot_inventory_id_field_name_key")
  @@index([builder_id], map: "idx_lot_custom_fields_builder_id")
  @@index([lot_id], map: "idx_lot_custom_fields_lot_id")
}

