/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model construction_stages {
  construction_stage_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  builder_id            String    @db.Uuid
  division_id           String    @db.Uuid
  construction_stage    Int
  description           String    @db.VarChar(200)
  created_by            String?   @db.Uuid
  created_at            DateTime? @default(now()) @db.Timestamptz(6)
  updated_at            DateTime? @default(now()) @db.Timestamptz(6)
  builders              builders  @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction)
  users                 users?    @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([builder_id, division_id, construction_stage])
  @@index([builder_id], map: "idx_construction_stages_builder_id")
  @@index([division_id], map: "idx_construction_stages_division_id")
}
