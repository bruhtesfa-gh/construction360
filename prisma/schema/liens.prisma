/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model lien_templates {
  lien_template_id                        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  builder_id                              String    @db.Uuid
  template_name                           String    @db.VarChar(200)
  template_description                    String?
  lien_type                               String?   @db.VarChar(100)
  state_code                              String?   @db.VarChar(10)
  template_content                        String?
  required_fields                         Json?
  filing_deadline_days                    Int?
  notice_period_days                      Int?
  is_active                               Boolean?  @default(true)
  created_by                              String?   @db.Uuid
  modified_by                             String?   @db.Uuid
  created_at                              DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                              DateTime? @default(now()) @db.Timestamptz(6)
  builders                                builders  @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction)
  users_lien_templates_created_byTousers  users?    @relation("lien_templates_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_lien_templates_modified_byTousers users?    @relation("lien_templates_modified_byTousers", fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([builder_id], map: "idx_lien_templates_builder_id")
  @@index([state_code], map: "idx_lien_templates_state")
  @@index([lien_type], map: "idx_lien_templates_type")
}

