  release_to_estimating_date       DateTime                        @default(now()) @db.Timestamp(6)
  project_manager_id               String?                         @db.Uuid
  estimator_id                     String?                         @db.Uuid
  design_center_sales_person_id    String?                         @db.Uuid
  addl_premium                     Decimal?                        @db.Decimal(12, 2)
  sales_person_id                  String?                         @db.Uuid
  pre_construction_stage           Int?
  sequence                         BigInt                          @default(autoincrement())
  floor_plan_assembly_id           String?                         @db.Uuid
  elevation_assembly_id            String?                         @db.Uuid
  home_type                        String?                         @db.VarChar(50)
  pre_contract_selection_sheet     String?                         @db.Uuid
  post_contract_selection_sheet    String?                         @db.Uuid
  description                      String?                         @db.VarChar(200)
  marketing_info                   String?
  cancelled_date                   DateTime?                       @db.Timestamp(6)
  cancelled_by                     String?                         @db.Uuid
  loan_draws_received              Decimal?                        @db.Decimal(12, 2)
  deposits_received                Decimal?                        @db.Decimal(12, 2)
  total_closing_adjustments        Decimal?                        @db.Decimal(12, 2)
  hoa_id                           String?                         @db.Uuid
  sales_commission_rate_on_base    Decimal?                        @db.Decimal(6, 2)
  sales_commission_rate_on_lot     Decimal?                        @db.Decimal(6, 2)
  sales_commission_rate_on_options Decimal?                        @db.Decimal(6, 2)
  created_by                       String                          @db.Uuid
  modified_by                      String                          @db.Uuid
  created_at                       DateTime?                       @default(now()) @db.Timestamp(6)
  updated_at                       DateTime?                       @default(now()) @db.Timestamp(6)
  home_inspections                 home_inspections[]
  home_selection_sheet_response    home_selection_sheet_response[]
  builders                         builders                        @relation(fields: [builder_id], references: [builder_id], onDelete: Cascade, onUpdate: NoAction)
  communities                      communities                     @relation(fields: [community_id], references: [community_id], onDelete: Cascade, onUpdate: NoAction)
  floor_plan_community             floor_plan_community?           @relation(fields: [floor_plan_id], references: [floor_plan_community_id], onDelete: NoAction, onUpdate: NoAction)
  regions                          regions                         @relation(fields: [region_id], references: [region_id], onDelete: Cascade, onUpdate: NoAction)
  tickets                          tickets[]
  warranty_problems                warranty_problems[]

  @@index([builder_id], map: "idx_homes_builder_id")
  @@index([community_id], map: "idx_homes_community_id")
  @@index([floor_plan_id], map: "idx_homes_floor_plan_id")
